<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RGui"
        x:Class="RGui.MainWindow"
        Title="RGui — ripgrep"
        Width="900" Height="650"
        MinWidth="500" MinHeight="300">

    <DockPanel>

        <!-- Top: inputs -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="12,12,12,8">

            <!-- Pattern row -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="PatternBox"
                         Grid.Column="0"
                         PlaceholderText="Search pattern…"
                         FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                         KeyDown="PatternBox_KeyDown"/>
                <Button x:Name="SearchBtn"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Search"
                        Click="OnSearch"/>
            </Grid>

            <!-- Path row -->
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="PathBox"
                         Grid.Column="0"
                         PlaceholderText="Search path…"/>
                <Button x:Name="BrowseBtn"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Browse…"
                        Click="OnBrowse"/>
                <Button x:Name="CancelBtn"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="Cancel"
                        IsEnabled="False"
                        Click="OnCancel"/>
            </Grid>

            <!-- Options row -->
            <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="CaseSensitiveCheck" Content="Case sensitive" IsChecked="True" Margin="0,0,16,0"/>
                <CheckBox x:Name="RegexCheck" Content="Regex" IsChecked="True"/>
            </WrapPanel>

        </StackPanel>

        <!-- Bottom: status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Opacity="0.6"/>
                <TextBlock x:Name="DotsText"
                           FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                           FontSize="12" Opacity="0.6"/>
            </StackPanel>
        </Border>

        <!-- Centre: results list -->
        <ListBox x:Name="ResultsList"
                 Margin="12,0,12,8"
                 DoubleTapped="ResultsList_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ResultItem">
                    <TextBlock Text="{Binding Display}"
                               FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
